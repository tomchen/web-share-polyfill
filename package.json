{
  "name": "web-share-polyfill",
  "version": "0.1.0",
  "description": "Web Share API polyfill: navigator.share() everywhere, with a tiny native-looking share sheet (copy link, QR code, email and 40+ apps) in 70 languages.",
  "keywords": [
    "web share",
    "web share api",
    "navigator.share",
    "polyfill",
    "share",
    "share sheet",
    "share button",
    "share dialog",
    "qr code",
    "social",
    "fallback"
  ],
  "homepage": "https://web-share-polyfill.js.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomchen/web-share-polyfill.git"
  },
  "bugs": "https://github.com/tomchen/web-share-polyfill/issues",
  "license": "MIT",
  "author": "Tom Chen (https://github.com/tomchen)",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "default": "./dist/targets.js"
    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "default": "./dist/full.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./simple": {
      "types": "./dist/simple.d.ts",
      "default": "./dist/simple.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "default": "./dist/qr.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/web-share-polyfill.js",
  "jsdelivr": "./dist/web-share-polyfill.js",
  "sideEffects": [
    "./dist/common.js",
    "./dist/all.js",
    "./dist/simple.js",
    "./dist/web-share-polyfill.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "icons": "bun scripts/icons.mjs",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:dist": "vitest run --project dist",
    "test:browser": "vitest run --project browser",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only",
    "check": "bun run typecheck && bun run format:check && bun run test && bun run build && bun run test:dist && bun run test:browser && bun run lint:pkg",
    "site": "bun run build && bun scripts/site.mjs",
    "dev": "bun run site && serve _site",
    "release": "vbt"
  },
  "vbt": {
    "push": true,
    "preBump": "bun run check",
    "files": [
      "README.md"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mdn/browser-compat-data": "^8.1.3",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "serve": "^14.2.6",
    "simple-icons": "^16.32.0",
    "svgpath": "^2.6.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vbt": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
